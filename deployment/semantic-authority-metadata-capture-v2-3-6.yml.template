# INERT TEMPLATE — not a deployable GitHub Actions workflow.
# Every @TOKEN@ must be replaced from the frozen deployment manifest only
# after the RFC-3161 schedule precommit exists.
name: semantic-authority-metadata-capture-v2-3-6
on:
  schedule:
    - cron: '@SCHEDULE_CRON@'
permissions:
  contents: read
  id-token: write
  attestations: write
jobs:
  capture:
    if: github.repository_id == '@REPOSITORY_ID@' && github.repository_owner_id == '@OWNER_ID@'
    runs-on: ubuntu-24.04
    container: python@sha256:edf6433343f65f94707985869aeaafe8beadaeaee11c4bc02068fca52dce28dd
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
        with:
          ref: '@WORKFLOW_COMMIT@'
          persist-credentials: false
      - name: Verify frozen orchestration is present but inert
        env:
          PYTHONPATH: src
        run: python -m pastila_scout.semantic_authority_capture_orchestrator_v2_3_7
      # Activation replaces the inert command only from a separately frozen
      # deployment manifest. The attestation action itself is immutable-pinned:
      # actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6
