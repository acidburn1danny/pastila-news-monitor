# INERT V2.3.14 TEMPLATE. Rename into .github/workflows only after the workflow
# freeze commit, RFC-3161 receipt, and final deployment manifest are all frozen.
name: semantic-authority-attestation-only-pre-capture-v2-3-15
on:
  schedule:
    - cron: '@SCHEDULE_CRON@'
permissions:
  contents: read
  id-token: write
  attestations: write
  artifact-metadata: write
jobs:
  capture:
    if: github.repository_id == '1355263083' && github.repository == 'acidburn1danny/pastila-news-monitor' && github.run_attempt == 1 && github.event_name == 'schedule' && github.event.schedule == '@SCHEDULE_CRON@'
    runs-on: ubuntu-24.04
    container: python@sha256:edf6433343f65f94707985869aeaafe8beadaeaee11c4bc02068fca52dce28dd
    env:
      PYTHONPATH: ${{ github.workspace }}/src
      PASTILA_EVENT_SCHEDULE: ${{ github.event.schedule }}
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - name: Verify frozen execution-source closure
        run: |
          printf '%s\n' \
            '00c40f308e27cdb3776e7fa6fb68712f8e2424532a08629d3247434e391221da  src/pastila_scout/__init__.py' \
            '5179804c9e385897cd2579d183b902b64583913d43fdd9f84d70698bbfd05d14  src/pastila_scout/semantic_authority_capture_orchestrator_v2_3_7.py' \
            '80a0b2500c1fe629b6111432e27b3fc288f9441146b1d0f27bea772bde918ea8  src/pastila_scout/semantic_authority_cosign_v2_3_7.py' \
            '539745950274dc8f8decd8eb22975aff36c0966aa264d2f8fc27fb84926bcc06  src/pastila_scout/semantic_authority_public_attestation_v2_3_6.py' \
            'fe007159bb36237818af926bc42b64879296a47c0322818eecea9633054e635d  src/pastila_scout/semantic_authority_deployment_v2_3_10.py' \
            'cdba88022b2b53d7d8c77c0d46bc5eced72e401b4ac674d271dea89b74ff7b02  src/pastila_scout/semantic_authority_deployment_v2_3_14.py' \
            '5975a5e06277f4a7c745ab7ea1c46060b5d6762fe5715e8f03c1da662902c939  src/pastila_scout/semantic_authority_deployment_v2_3_9.py' \
            'a5a7cf3e01e3605b83bd8754ec33269b670b4e89d8398a1ba598158c3f45d090  src/pastila_scout/semantic_authority_rfc3161_verifier_v2_3_13.py' | sha256sum -c -
      - name: Reconstruct frozen Cosign executable from GitHub-compatible chunks
        run: |
          printf '%s\n' \
            '4f5025b78f963e81121a3dcc161b0b7c9e72c57f0ba3e2173e4fbd9fd6be5714  deployment/objects/cosign.part-00' \
            'a18b5085c92dbbf4cc473c320475c42fe7bddd24d9b8aac40885d9fb3683d5ed  deployment/objects/cosign.part-01' \
            'eb25658f585ca5d92202fae04bd84ee15101129d92f636979abc37d7814c12d3  deployment/objects/cosign.part-02' | sha256sum -c -
          cat deployment/objects/cosign.part-00 deployment/objects/cosign.part-01 deployment/objects/cosign.part-02 > "$RUNNER_TEMP/cosign"
          printf '%s\n' '4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71  '"$RUNNER_TEMP/cosign" | sha256sum -c -
          install -m 0755 "$RUNNER_TEMP/cosign" deployment/objects/cosign
      - name: Verify immutable deployment objects and RFC-3161 precommit
        run: python -I -S -c "import runpy,sys;sys.path.insert(0,'${{ github.workspace }}/src');runpy.run_module('pastila_scout.semantic_authority_deployment_v2_3_14',run_name='__main__')" --manifest deployment/v2-3-15-manifest.json --prepare-initiation "$RUNNER_TEMP/initiation"
      - name: Create public initiation attestation before any publisher capture
        id: initiation
        uses: actions/attest@@ATTEST_ACTION_COMMIT@
        with:
          subject-path: ${{ runner.temp }}/initiation/pastila-capture-initiation.json
          predicate-type: https://pastila.invalid/semantic-authority/initiation/v2.3.9
          predicate-path: ${{ runner.temp }}/initiation/predicate.json
          push-to-registry: false
      - name: Verify initiation bundle and complete attestation-only pre-capture state
        run: python -I -S -c "import runpy,sys;sys.path.insert(0,'${{ github.workspace }}/src');runpy.run_module('pastila_scout.semantic_authority_deployment_v2_3_14',run_name='__main__')" --manifest deployment/v2-3-15-manifest.json --initiation-bundle '${{ steps.initiation.outputs.bundle-path }}' --complete-attestation-only
      - name: Create final public attestation-only pre-capture attestation
        id: final
        uses: actions/attest@@ATTEST_ACTION_COMMIT@
        with:
          subject-path: attestation-only-output/pre-capture-deployment-state.json
          predicate-type: https://pastila.invalid/semantic-authority/pre-capture-activation/v2.3.15
          predicate-path: attestation-only-output/final-predicate.json
          push-to-registry: false
      - name: Bind final bundle into durable output
        run: cp '${{ steps.final.outputs.bundle-path }}' attestation-only-output/final-attestation-bundle.json
      - name: Publish immutable hash-reporting pre-capture artifact
        uses: actions/upload-artifact@@UPLOAD_ACTION_COMMIT@
        with:
          name: semantic-authority-pre-capture-activation-${{ github.run_id }}
          path: attestation-only-output
          if-no-files-found: error
          retention-days: 30
          compression-level: 0
          overwrite: false
