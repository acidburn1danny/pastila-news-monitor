{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:pastila:semantic-admission-v2:stage-p-ledger:v1",
  "type":"object",
  "additionalProperties":false,
  "required":["stage_id","coverage_decision","entries","coverage_receipt"],
  "properties":{
    "stage_id":{"const":"PROPOSITION_LEDGER"},
    "coverage_decision":{"enum":["COMPLETE","INDETERMINATE"]},
    "entries":{"type":"array","minItems":1,"maxItems":8,"items":{"$ref":"#/$defs/entry"}},
    "coverage_receipt":{"$ref":"#/$defs/receipt"}
  },
  "$defs":{
    "entry":{
      "type":"object","additionalProperties":false,
      "required":["entry_id","entry_type","candidate_span","authority_support","commitment","scope_basis","event_alignment","authority_modality","candidate_modality","authority_timing","candidate_timing","independence_group"],
      "properties":{
        "entry_id":{"type":"string","pattern":"^P[1-8]$"},
        "entry_type":{"enum":["REAL_WORLD_COMMITMENT","CONTAINED_CREATIVE","UNRESOLVED_SCOPE"]},
        "candidate_span":{"type":"string","minLength":1},
        "authority_support":{"type":["string","null"]},
        "commitment":{"type":"string","minLength":1,"maxLength":500},
        "scope_basis":{"enum":["ASSERTED","PRESUPPOSED","ENTAILED","NECESSARILY_IMPLIED","CREATIVE_CONTAINED","UNRESOLVED"]},
        "event_alignment":{"enum":["GOVERNED_EVENT","NEW_UNSUPPORTED_EVENT","CREATIVE_VEHICLE_ONLY","UNRESOLVED"]},
        "authority_modality":{"$ref":"#/$defs/modality"},
        "candidate_modality":{"$ref":"#/$defs/modality"},
        "authority_timing":{"$ref":"#/$defs/timing"},
        "candidate_timing":{"$ref":"#/$defs/timing"},
        "independence_group":{"type":"string","pattern":"^G[1-8]$"}
      }
    },
    "modality":{"enum":["NOT_APPLICABLE","POSSIBLE","CONDITIONAL","PROPOSED","EXPECTED","CERTAIN_OR_ACTUAL","UNRESOLVED"]},
    "timing":{"enum":["NOT_APPLICABLE","PAST","PRESENT","ONGOING","FUTURE","COMPLETED","UNDATED","UNRESOLVED"]},
    "receipt":{
      "type":"object","additionalProperties":false,
      "required":["candidate_reviewed_as_whole","embedded_propositions_checked","creative_scope_checked","unresolved_scope_present"],
      "properties":{
        "candidate_reviewed_as_whole":{"type":"boolean"},
        "embedded_propositions_checked":{"type":"boolean"},
        "creative_scope_checked":{"type":"boolean"},
        "unresolved_scope_present":{"type":"boolean"}
      }
    }
  }
}
