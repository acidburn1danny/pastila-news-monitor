{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:pastila:semantic-admission-v2:stage-c-gate-f:v1",
  "title":"Existing Gate F response contract reused unchanged by Stage C",
  "type":"object",
  "additionalProperties":false,
  "required":["gate_id","decision","reason_records"],
  "properties":{
    "gate_id":{"const":"FACTUAL_SEMANTIC"},
    "decision":{"enum":["PASS","FAIL","INDETERMINATE"]},
    "reason_records":{"type":"array","maxItems":8,"items":{"$ref":"#/$defs/reason"}}
  },
  "$defs":{
    "reason":{
      "type":"object","additionalProperties":false,
      "required":["code","status","candidate_span","authority_support","unsupported_proposition","confidence"],
      "properties":{
        "code":{"enum":["FSEM_CERTAINTY_MUTATION","FSEM_FICTION_RETURN_TO_FACT","FSEM_INVENTED_SPEECH_OR_ROLE_KNOWLEDGE","FSEM_TIMING_MUTATION","FSEM_UNSUPPORTED_BIOGRAPHY_OR_HISTORY","FSEM_UNSUPPORTED_CAPACITY","FSEM_UNSUPPORTED_CAUSALITY","FSEM_UNSUPPORTED_EMOTION_OR_REACTION","FSEM_UNSUPPORTED_LIFE_STAKES","FSEM_UNSUPPORTED_MOTIVE_OR_INTENT","FSEM_UNSUPPORTED_OUTCOME_OR_STATUS","FSEM_UNSUPPORTED_PREMISE_TO_DIRECTIVE","ADMISSION_INDETERMINATE"]},
        "status":{"enum":["DECISIVE","SUPPORTING","DEFENSE_IN_DEPTH_ONLY"]},
        "candidate_span":{"type":["string","null"]},
        "authority_support":{"type":["string","null"]},
        "unsupported_proposition":{"type":["string","null"]},
        "confidence":{"type":"number","minimum":0,"maximum":1}
      }
    }
  }
}
