{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "V5_4_SEMANTIC_RULE_ADMISSION_SCHEMA_V1",
  "title": "V5.4 independently admitted semantic rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","curriculum_cell","origin","provenance","predicate_family","actor_classes","patient_classes","actor_roles","patient_roles","required_affordances","preconditions","transition","result","counterfactual","non_substitutability","composition","scope","author_identity","adjudication_receipt","rule_identity"],
  "properties": {
    "schema_version":{"const":"1.0.0"},
    "curriculum_cell":{"type":"string","minLength":1},
    "origin":{"enum":["FROZEN_GENERIC_ONTOLOGY","SOURCE_DERIVED_EXACTLY_AUTHORIZED"]},
    "provenance":{"type":"object","required":["design_basis","created_before_family_access","blind_access"],"additionalProperties":false,"properties":{"design_basis":{"type":"array","minItems":1,"items":{"type":"string"}},"created_before_family_access":{"const":true},"blind_access":{"const":false}}},
    "predicate_family":{"type":"string","minLength":1},
    "actor_classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "patient_classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "actor_roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "patient_roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "required_affordances":{"type":"object","required":["actor","patient"],"additionalProperties":false,"properties":{"actor":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"patient":{"type":"array","uniqueItems":true,"items":{"type":"string"}}}},
    "preconditions":{"type":"array","minItems":1,"items":{"type":"string"}},
    "transition":{"type":"object","required":["direction","predecessor_consumption"],"additionalProperties":false,"properties":{"direction":{"type":"string"},"predecessor_consumption":{"enum":["REQUIRED","NOT_APPLICABLE_ANCHOR"]}}},
    "result":{"type":"object","required":["class","roles","affordances"],"additionalProperties":false,"properties":{"class":{"type":"string"},"roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"affordances":{"type":"array","uniqueItems":true,"items":{"type":"string"}}}},
    "counterfactual":{"type":"object","required":["test","expected"],"additionalProperties":false,"properties":{"test":{"type":"string"},"expected":{"const":"SUCCESSOR_RELATION_BREAKS"}}},
    "non_substitutability":{"type":"object","required":["comparison_domain","maximum_compatible_rules"],"additionalProperties":false,"properties":{"comparison_domain":{"type":"string"},"maximum_compatible_rules":{"const":1}}},
    "composition":{"type":"object","required":["anchor","intermediate","terminal","consumable_result_classes"],"additionalProperties":false,"properties":{"anchor":{"type":"boolean"},"intermediate":{"type":"boolean"},"terminal":{"type":"boolean"},"consumable_result_classes":{"type":"array","uniqueItems":true,"items":{"type":"string"}}}},
    "scope":{"type":"object","required":["domains","exclusions","version"],"additionalProperties":false,"properties":{"domains":{"type":"array","minItems":1,"items":{"type":"string"}},"exclusions":{"type":"array","items":{"type":"string"}},"version":{"type":"string"}}},
    "author_identity":{"type":"string","minLength":1},
    "adjudication_receipt":{"type":"string","minLength":1},
    "rule_identity":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "canonical_identity": "SHA256(RFC8785_CANONICAL_JSON_OF_ALL_REQUIRED_SEMANTIC_CONTENT_EXCLUDING_RULE_IDENTITY_AND_ADJUDICATION_RECEIPT)",
  "label_has_no_authority": true
}
