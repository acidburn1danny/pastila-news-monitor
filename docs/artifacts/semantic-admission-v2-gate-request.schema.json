{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pastila://schemas/semantic-admission-v2-gate-request/1.0.0",
  "oneOf": [
    {
      "type":"object","additionalProperties":false,
      "required":["gate_id","factual_summary","candidate"],
      "properties":{"gate_id":{"const":"FACTUAL_SEMANTIC"},"factual_summary":{"type":"string","minLength":20},"candidate":{"type":"string","minLength":1}}
    },
    {
      "type":"object","additionalProperties":false,
      "required":["gate_id","factual_summary","candidate","controls"],
      "properties":{
        "gate_id":{"const":"STORY_SPECIFICITY"},"factual_summary":{"type":"string","minLength":20},"candidate":{"type":"string","minLength":1},
        "controls":{"type":"array","minItems":2,"maxItems":3,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["case_id","factual_summary","factual_summary_sha256","authority_identity"],"properties":{"case_id":{"type":"string"},"factual_summary":{"type":"string","minLength":20},"factual_summary_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"authority_identity":{"type":"string"}}}}
      }
    }
  ]
}
